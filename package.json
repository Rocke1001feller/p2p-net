{
  "name": "@rocke1001feller/p2p-net",
  "version": "0.2.0",
  "description": "Self-hosted WebRTC remote-access data plane: your Supabase + your VPS = phone-to-desktop in 5 minutes",
  "keywords": [
    "webrtc",
    "p2p",
    "remote-access",
    "self-hosted",
    "supabase",
    "turn",
    "pwa",
    "tunnel"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "p2p-net": "dist/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "node-init/",
    "pwa-dist/",
    "supabase/",
    "contracts/",
    "assets/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run test:parallel && npm run test:serial && npm run test:parity",
    "test:parallel": "tsx --test \"src/**/*.test.ts\" \"pwa/src/**/*.test.ts\"",
    "test:serial": "tsx --test src/tests/hol-gate.serial.ts",
    "test:parity": "tsx --test \"src/**/*.parity.ts\" \"pwa/src/**/*.parity.ts\"",
    "build:pwa": "npm run build && npm --prefix pwa run build && node -e \"const fs=require('fs');fs.rmSync('pwa-dist',{recursive:true,force:true});fs.cpSync('pwa/dist','pwa-dist',{recursive:true})\"",
    "prepack": "npm run build && npm run build:pwa"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "ssh2": "^1.16.0",
    "werift": "^0.24.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0"
  }
}
